# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/
ENV/

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo
*~

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db
*:Zone.Identifier

# =========================
# Raw datasets
# =========================
data/raw/

# =========================
# Generated / processed data
# =========================
data/processed/

# =========================
# Experiment outputs
# =========================
outputs/

# =========================
# Archives / downloaded files
# =========================
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Paddle / model cache
# =========================
.paddlex/
.paddleocr/
models/
checkpoints/
weights/

# =========================
# Temporary files
# =========================
tmp/
temp/
*.tmp

# Keep directory placeholders if needed
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/.gitkeep
